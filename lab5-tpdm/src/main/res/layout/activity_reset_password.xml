<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pink"
    android:fillViewport="true"
    tools:context=".ResetPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/bienvenue_s"
            android:src="@drawable/img" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:text="@string/reinitialiser_titre"
            android:textAppearance="@style/bienvenue_s" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="23dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="23dp"
            android:gravity="center_horizontal"
            android:text="@string/reinitialiser_aide"
            android:textAppearance="@style/connectez_v" />

        <EditText
            android:id="@+id/username"
            style="@style/input_style"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="23dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="23dp"
            android:autofillHints="username"
            android:hint="@string/hint_username"
            android:inputType="text" />

        <EditText
            android:id="@+id/cin"
            style="@style/input_style"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="23dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="23dp"
            android:hint="@string/hint_cin"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:maxLength="8" />

        <EditText
            android:id="@+id/mot_de_pass"
            style="@style/input_style"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="23dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="23dp"
            android:autofillHints="newPassword"
            android:hint="@string/hint_nouveau_mot_de_passe"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/confirm_mot_de_pass"
            style="@style/input_style"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="23dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="23dp"
            android:autofillHints="newPassword"
            android:hint="@string/hint_confirmer_mot_de_passe"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/retour_connexion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="23dp"
            android:onClick="retourConnexion"
            android:text="@string/retour_connexion"
            android:textAppearance="@style/signup" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn"
            style="@style/login"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:layout_marginStart="23dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="23dp"
            android:onClick="resetPassword"
            android:text="@string/reinitialiser" />

        <TextView
            android:id="@+id/txtformval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:textColor="@color/error"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
